    "files.associations": {
        "cstdlib": "c",
        "rtklib.h": "c",
        "limits": "c",
        "type_traits": "c",
        "typeinfo": "c",
        "cmath": "c",
        "cctype": "c",
        "climits": "c",
        "cstdarg": "c",
        "cstdint": "c",
        "cstdio": "c",
        "cwchar": "c",
